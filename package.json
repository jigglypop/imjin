{
  "name": "imjin-naval",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "e2e:clicks": "node scripts/e2e-clicks.mjs",
    "test": "node scripts/run-tests.mjs",
    "shot": "node scripts/shot.mjs",
    "e2e": "node scripts/e2e.mjs",
    "server:build": "node scripts/build-server.mjs",
    "server": "npm run server:build && node server/dist/server.cjs",
    "server:dev": "npm run server:build && node --env-file=.env.development server/dist/server.cjs",
    "assets": "node scripts/assets.mjs",
    "db:dev": "docker compose -f infra/dev-db.compose.yml up -d --wait",
    "db:dev:down": "docker compose -f infra/dev-db.compose.yml down"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
