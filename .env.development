# Local development only: the Docker PostgreSQL of infra/dev-db.compose.yml (npm run db:dev). No real secrets here.
# The multiplayer server reads this with `npm run server:dev`; the server migrates the schema itself on start.
DATABASE_URL=postgres://imjin:imjin-dev@127.0.0.1:5433/imjin?sslmode=disable
# For scripts/test-meta-server.mjs: it makes and drops a throwaway database on it.
DATABASE_TEST_URL=postgres://imjin:imjin-dev@127.0.0.1:5433/postgres?sslmode=disable
